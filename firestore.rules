rules_version = '2';

// Lisansla güvenlik kuralları (sürüm 2)
// - Herkes yalnızca kendi verisini okuyabilir, yazabilir ve silebilir.
// - "premium" alanını uygulama yazamaz; yalnızca ödeme doğrulanınca sunucu tarafında yazılır.
// - Toplu istatistikleri (cozumler, oylar, hatalar, gorusler) sadece proje sahibi Firebase konsolundan görür.
service cloud.firestore {
  match /databases/{database}/documents {

    function girisli() { return request.auth != null; }
    function veri() { return request.resource.data; }
    function kendisi() { return veri().uid == request.auth.uid; }
    function sahibi() { return girisli() && resource.data.uid == request.auth.uid; }
    function simdi() { return veri().zaman == request.time; }
    function kisaMetin(alan, enFazla) {
      return veri()[alan] is string && veri()[alan].size() > 0 && veri()[alan].size() <= enFazla;
    }

    // ---- Kullanıcının kendi alanı ----
    match /kullanicilar/{uid} {
      allow read, delete: if girisli() && request.auth.uid == uid;
      // "premium" alanını sadece sunucu yazabilir (ödeme doğrulaması).
      allow create: if girisli() && request.auth.uid == uid
        && !('premium' in veri()) && gecerliAd();
      allow update: if girisli() && request.auth.uid == uid
        && !veri().diff(resource.data).affectedKeys().hasAny(['premium'])
        && gecerliAd();

      function gecerliAd() {
        return !('ad' in veri()) || (veri().ad is string && veri().ad.size() <= 40);
      }

      match /{alt}/{belge} {
        allow read, write: if girisli() && request.auth.uid == uid
          && alt in ['hedefler', 'ilerleme', 'gunler', 'denemeler', 'sonuclar'];
      }
    }

    // ---- Soru kalitesi için geri bildirim ----
    // ---- Sıralama (sadece katılmayı seçenler) ----
    match /siralama/{uid} {
      allow read: if girisli();
      allow delete: if girisli() && request.auth.uid == uid;
      allow create, update: if girisli() && request.auth.uid == uid
        && veri().takmaAd is string && veri().takmaAd.size() >= 2 && veri().takmaAd.size() <= 20
        && veri().size() <= 80
        && get(/databases/$(database)/documents/takmaAdlar/$(veri().takmaAd.lower())).data.uid == request.auth.uid;
    }

    // Her takma ad tek kullanıcıya ait; güncelleme yok, sadece sahibi bırakabilir.
    match /takmaAdlar/{ad} {
      allow read: if girisli();
      allow create: if girisli() && veri().uid == request.auth.uid && veri().keys().hasOnly(['uid'])
        && ad.size() >= 2 && ad.size() <= 20;
      allow delete: if girisli() && resource.data.uid == request.auth.uid;
    }

    // ---- Düello: kuran oynar, kodu paylaşır; rakip bir kez sonucunu yazar ----
    match /duellolar/{kod} {
      allow read: if girisli();
      allow create: if girisli() && kod.size() == 6 && veri().kurucu == request.auth.uid
        && veri().keys().hasOnly(['kurucu', 'kurucuAd', 'sorular', 'kurucuDogru', 'kurucuSure', 'rakip', 'zaman', 'lisans'])
        && veri().rakip == null && veri().sorular.size() <= 10
        && veri().kurucuAd is string && veri().kurucuAd.size() <= 40;
      allow update: if girisli() && resource.data.rakip == null && resource.data.kurucu != request.auth.uid
        && veri().diff(resource.data).affectedKeys().hasOnly(['rakip', 'rakipAd', 'rakipDogru', 'rakipSure', 'rakipZaman'])
        && veri().rakip == request.auth.uid
        && veri().rakipAd is string && veri().rakipAd.size() <= 40;
      allow delete: if girisli() && resource.data.kurucu == request.auth.uid;
    }

    // ---- Davet ----
    // ---- Kısa videolar: beğeni ve yorumlar ----
    // Beğeni sayısı belge sayımıyla bulunur; herkes yalnızca kendi beğenisini yazar ya da siler.
    match /kisaBegeni/{id} {
      allow read: if girisli();
      allow create: if girisli() && kendisi() && veri().keys().hasOnly(['kisa', 'uid'])
        && veri().kisa is string && veri().kisa.size() <= 60
        && id == veri().kisa + '_' + request.auth.uid;
      allow delete: if sahibi();
    }

    // Bir listede yalnızca kendi kimliğini ekleyip çıkarabilirsin (yorum beğenisi, bildirim).
    function sadeceKendisi(alan) {
      let once = resource.data.get(alan, []).toSet();
      let sonra = veri().get(alan, []).toSet();
      let ben = [request.auth.uid].toSet();
      return sonra == once
        || (sonra.difference(once) == ben && once.difference(sonra).size() == 0)
        || (once.difference(sonra) == ben && sonra.difference(once).size() == 0);
    }

    match /kisaYorum/{id} {
      allow read: if girisli();
      allow delete: if sahibi();
      allow create: if girisli() && kendisi() && simdi()
        && veri().keys().hasOnly(['uid', 'takmaAd', 'kisa', 'metin', 'zaman', 'begenenler', 'sikayetEdenler'])
        && veri().kisa is string && veri().kisa.size() <= 60
        && veri().metin is string && veri().metin.size() >= 1 && veri().metin.size() <= 300
        && veri().begenenler.size() == 0 && veri().sikayetEdenler.size() == 0
        && veri().takmaAd is string && veri().takmaAd.size() >= 2 && veri().takmaAd.size() <= 20
        && get(/databases/$(database)/documents/takmaAdlar/$(veri().takmaAd.lower())).data.uid == request.auth.uid;
      allow update: if girisli()
        && veri().diff(resource.data).affectedKeys().hasOnly(['begenenler', 'sikayetEdenler'])
        && sadeceKendisi('begenenler') && sadeceKendisi('sikayetEdenler');
    }

    // ---- Ana sayfa: topluluk akışı ve şu an çevrimiçi olanlar ----
    // Akışa sadece takma adının sahibi yazar; metin cihazda üretilir, kayıtta serbest yazı yok.
    match /akis/{id} {
      allow read: if girisli();
      allow delete: if sahibi();
      allow create: if girisli() && kendisi() && simdi()
        && veri().keys().hasOnly(['uid', 'takmaAd', 'tur', 'ders', 'deger', 'zaman'])
        && veri().tur in ['gecti', 'deneme', 'duello', 'rozet']
        && (veri().ders == null || (veri().ders is string && veri().ders.size() <= 30))
        && veri().deger is int && veri().deger >= 0 && veri().deger <= 100
        && veri().takmaAd is string && veri().takmaAd.size() >= 2 && veri().takmaAd.size() <= 20
        && get(/databases/$(database)/documents/takmaAdlar/$(veri().takmaAd.lower())).data.uid == request.auth.uid;
    }

    // Kimlik yazılmaz: sadece zaman ve seçili lisans. Sayaç için okunur.
    match /cevrimici/{uid} {
      allow read: if girisli();
      allow delete: if girisli() && request.auth.uid == uid;
      allow create, update: if girisli() && request.auth.uid == uid && simdi()
        && veri().keys().hasOnly(['zaman', 'lisans'])
        && (veri().lisans == null || (veri().lisans is string && veri().lisans.size() <= 30));
    }

    // ---- Canlı düello: rakip arayanlar ve maçlar ----
    match /bekleyenler/{uid} {
      allow read: if girisli();
      allow create: if girisli() && request.auth.uid == uid
        && veri().keys().hasOnly(['uid', 'ad', 'ders', 'lisans', 'zaman', 'mac'])
        && veri().mac == null && veri().ad is string && veri().ad.size() <= 40;
      allow delete: if girisli() && request.auth.uid == uid;
      allow update: if girisli() && request.auth.uid != uid && resource.data.mac == null
        && veri().diff(resource.data).affectedKeys().hasOnly(['mac']) && veri().mac is string;
    }

    match /maclar/{id} {
      allow read: if girisli() && request.auth.uid in resource.data.oyuncular;
      allow create: if girisli() && request.auth.uid in veri().oyuncular && veri().oyuncular.size() == 2
        && veri().keys().hasOnly(['oyuncular', 'adlar', 'sorular', 'ders', 'zaman', 'ilerleme'])
        && veri().sorular.size() <= 10;
      allow update: if girisli() && request.auth.uid in resource.data.oyuncular
        && veri().diff(resource.data).affectedKeys().hasOnly(['ilerleme'])
        && veri().ilerleme.diff(resource.data.ilerleme).affectedKeys().hasOnly([request.auth.uid]);
    }

    match /kodlar/{kod} {
      allow read: if girisli();
      allow create: if girisli() && veri().uid == request.auth.uid && kod.size() == 8;
      allow delete: if girisli() && resource.data.uid == request.auth.uid;
    }

    match /davetler/{uid} {
      allow read: if girisli() && (request.auth.uid == uid || resource.data.davetEden == request.auth.uid);
      allow delete: if girisli() && (request.auth.uid == uid || resource.data.davetEden == request.auth.uid);
      allow create: if girisli() && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && veri().keys().hasOnly(['davetEden', 'kod', 'gecerli', 'zaman'])
        && veri().davetEden != uid
        && veri().gecerli == false
        && get(/databases/$(database)/documents/kodlar/$(veri().kod)).data.uid == veri().davetEden;
      allow update: if girisli() && request.auth.uid == uid
        && veri().diff(resource.data).affectedKeys().hasOnly(['gecerli'])
        && veri().gecerli == true;
    }

    match /cozumler/{kayit} {
      allow read, delete: if sahibi();
      allow create: if girisli() && kendisi() && simdi()
        && veri().keys().hasOnly(['uid', 'soru', 'secim', 'dogru', 'mod', 'zaman', 'surum'])
        && kisaMetin('soru', 40)
        && veri().secim is int && veri().secim >= 0 && veri().secim <= 4
        && veri().dogru is bool
        && kisaMetin('mod', 20);
    }

    match /oylar/{kayit} {
      allow read, delete: if sahibi();
      allow create, update: if girisli() && kendisi() && simdi()
        && kayit == veri().soru + '__' + request.auth.uid
        && veri().keys().hasOnly(['uid', 'soru', 'oy', 'zaman'])
        && veri().oy in [-1, 0, 1];
    }

    match /hatalar/{kayit} {
      allow read, delete: if sahibi();
      allow create: if girisli() && kendisi() && simdi()
        && veri().keys().hasOnly(['uid', 'soru', 'metin', 'zaman', 'surum'])
        && kisaMetin('soru', 40)
        && kisaMetin('metin', 500);
    }

    match /gorusler/{kayit} {
      allow read, delete: if sahibi();
      allow create: if girisli() && kendisi() && simdi()
        && veri().keys().hasOnly(['uid', 'metin', 'puan', 'zaman', 'surum'])
        && kisaMetin('metin', 2000)
        && veri().puan is int && veri().puan >= 0 && veri().puan <= 5;
    }
  }
}
