rules_version = '2';

// Lisansla güvenlik kuralları
// - Uygulama yalnızca anonim girişle yazabilir, hiçbir şey okuyamaz.
// - Herkes yalnızca kendi kimliğiyle kayıt ekler; başkasının kaydını değiştiremez.
// - Toplanan verileri sadece proje sahibi Firebase konsolundan görür.
service cloud.firestore {
  match /databases/{database}/documents {

    function girisli() {
      return request.auth != null;
    }

    function veri() {
      return request.resource.data;
    }

    function kendisi() {
      return veri().uid == request.auth.uid;
    }

    function simdi() {
      return veri().zaman == request.time;
    }

    function kisaMetin(alan, enFazla) {
      return veri()[alan] is string && veri()[alan].size() > 0 && veri()[alan].size() <= enFazla;
    }

    // Her cevaplanan soru: hangi şık seçildi, doğru muydu
    match /cozumler/{kayit} {
      allow create: if girisli() && kendisi() && simdi()
        && veri().keys().hasOnly(['uid', 'soru', 'secim', 'dogru', 'mod', 'zaman', 'surum'])
        && kisaMetin('soru', 40)
        && veri().secim is int && veri().secim >= 0 && veri().secim <= 4
        && veri().dogru is bool
        && kisaMetin('mod', 20);
    }

    // Soru başına kişi başı tek oy (belge adı: soruId__uid). 0 = oyu geri al
    match /oylar/{kayit} {
      allow create, update: if girisli() && kendisi() && simdi()
        && kayit == veri().soru + '__' + request.auth.uid
        && veri().keys().hasOnly(['uid', 'soru', 'oy', 'zaman'])
        && veri().oy in [-1, 0, 1];
    }

    // "Hata bildir" düğmesi
    match /hatalar/{kayit} {
      allow create: if girisli() && kendisi() && simdi()
        && veri().keys().hasOnly(['uid', 'soru', 'metin', 'zaman', 'surum'])
        && kisaMetin('soru', 40)
        && kisaMetin('metin', 500);
    }

    // "Görüşünü yaz" ekranı
    match /gorusler/{kayit} {
      allow create: if girisli() && kendisi() && simdi()
        && veri().keys().hasOnly(['uid', 'metin', 'puan', 'zaman', 'surum'])
        && kisaMetin('metin', 2000)
        && veri().puan is int && veri().puan >= 0 && veri().puan <= 5;
    }
  }
}
